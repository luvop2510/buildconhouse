# Vercel builds the web app and API proxy from the repository root.
# Exclude backend files and any local copies of the former frontend checkout.
backend/
frontend/

# Local/build artifacts and audit material are not deployment inputs.
.venv/
.expo/
.metro-cache/
.pytest_cache/
__pycache__/
dist/
output/
outputs/
test-results/
tmp/
template-inspect/
test_reports/
.screenshots/
.superpowers/
memory/

# Production configuration comes from the linked Vercel project's variables.
.env
.env.*
!.env.example

# Large business assets belong in MongoDB/Supabase, never in a frontend upload.
*.pdf
*.pptx
*.xlsx
