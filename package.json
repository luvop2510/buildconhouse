{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "preinstall": "./scripts/cmd-guard.js --preinstall",
    "postinstall": "node scripts/patch-react19-compat.mjs && node scripts/patch-uri-decoder-compat.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "node scripts/sites-build.mjs",
    "lint": "expo lint",
    "test:supplier-catalog": "node --experimental-strip-types --no-warnings scripts/test-catalog-source.mjs",
    "test:catalog-pagination": "node scripts/test-catalog-pagination.mjs",
    "test:quotation-media": "node --experimental-strip-types --no-warnings scripts/test-quotation-media.mjs",
    "test:downloads": "node scripts/test-download-file.mjs",
    "test:quotation-contract": "node --experimental-strip-types --no-warnings scripts/test-quotation-contract.mjs",
    "test:quotation-reorder": "node --experimental-strip-types --no-warnings scripts/test-quotation-reorder.mjs",
    "test:quotation-individual": "node scripts/test-quotation-individual.mjs",
    "test:multi-filters": "node --experimental-strip-types --no-warnings scripts/test-multi-filters.mjs",
    "test:section-excel": "node --experimental-strip-types --no-warnings scripts/test-section-excel.mjs",
    "preview:local": "node scripts/serve-local.mjs",
    "test:quotation-concealed-parts": "node --experimental-strip-types --no-warnings scripts/test-quotation-concealed-parts.mjs",
    "test:purchases-contract": "node scripts/test-purchases-contract.mjs && node scripts/test-purchase-floor-races.mjs",
    "test:notebook": "node --experimental-strip-types --no-warnings scripts/test-notebook.mjs",
    "test:mobile-ux": "node scripts/test-mobile-ux-contract.mjs && node scripts/test-keyboard-viewport.mjs",
    "test:frontend-drift": "node scripts/test-frontend-drift.mjs",
    "test:frontend-drift:browser": "playwright test --config playwright.forge-drift.config.ts --project=desktop --project=phone --workers=2",
    "test:mobile-budget": "node scripts/check-web-budget.mjs",
    "test:api-proxy": "node --no-warnings scripts/test-api-proxy.mjs",
    "test:api-client": "node scripts/test-api-client-contract.mjs",
    "test:e2e:profiles": "playwright test --config playwright.config.ts",
    "test:web-worker": "node scripts/test-web-worker.mjs",
    "test:sales-periods": "node --experimental-strip-types --no-warnings scripts/test-sales-periods.mjs",
    "test:monitoring-contract": "node scripts/test-monitoring-contract.mjs",
    "test:e2e:audit": "playwright test --config playwright.audit.config.ts",
    "test:frontend-performance": "node --experimental-strip-types --no-warnings scripts/test-frontend-performance.mjs",
    "test:sound-feedback": "node scripts/test-sound-feedback.mjs",
    "test:performance:audit": "node scripts/run-performance-audit.mjs",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "test:page-loading-performance": "node scripts/test-page-loading-performance.mjs",
    "test:icon-fonts": "node scripts/test-icon-font-contract.mjs",
    "test:release-recovery": "node scripts/test-release-recovery.mjs",
    "test:npm-audit": "node scripts/test-npm-audit.mjs",
    "test:service-health": "node scripts/test-service-health.mjs",
    "test:app-text": "node --experimental-strip-types --no-warnings scripts/test-app-text.mjs",
    "test:legal-config": "node --experimental-strip-types --no-warnings scripts/test-legal-config.mjs",
    "test:native-permissions": "node scripts/test-native-permissions.mjs",
    "test:stock-floor-races": "node scripts/test-stock-floor-races.mjs",
    "test:uptime-monitor": "node scripts/test-uptime-monitor.mjs",
    "test:shell-quote-security": "node scripts/test-shell-quote-security.mjs",
    "test:uri-decoder-security": "node scripts/test-uri-decoder-security.mjs",
    "test:font-assets": "node scripts/check-font-assets.mjs",
    "test:auth-provider-races": "node scripts/test-auth-provider-races.mjs",
    "test:team-contacts": "node --experimental-strip-types --no-warnings scripts/test-team-contacts.mjs",
    "test:customer-draft-reset": "node scripts/test-customer-draft-reset.mjs",
    "test:quotation-whatsapp": "node --experimental-strip-types --no-warnings scripts/test-quotation-whatsapp.mjs",
    "test:furniture-rmb": "node --experimental-strip-types --no-warnings scripts/test-furniture-rmb.mjs",
    "test:native-release-config": "node scripts/test-native-release-config.mjs",
    "test:history-lifecycle": "node scripts/test-history-lifecycle.mjs",
    "test:notebook-lifecycle": "node scripts/test-notebook-lifecycle.mjs",
    "test:release-stability": "node --experimental-strip-types --no-warnings scripts/test-release-stability.mjs",
    "test:e2e:stability": "playwright test --config playwright.stability.config.ts && node --experimental-strip-types --no-warnings scripts/verify-release-stability.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "date-fns": "4.1.0",
    "dayjs": "1.11.13",
    "expo": "55.0.31",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-dotenv": "3.4.11",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "~55.0.1",
    "expo-doctor": "1.20.4",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "decode-uri-component": "0.5.0",
    "@eslint/plugin-kit": "0.4.1",
    "postcss": "8.5.28",
    "uuid": "11.1.1"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "postcss": "8.5.28",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
